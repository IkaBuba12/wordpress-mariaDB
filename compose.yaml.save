services:
  mydb:
    image: mariadb:10.6.4-focal
    command: '--default-authentication-plugin=mysql_native_password'
    volumes:
      - mydb_data:/var/lib/mysql
    restart: always
    environment:
      - MYSQL_ROOT_PASSWORD=anypassword
      - MYSQL_DATABASE=wordpress
      - MYSQL_USER=wp_user
      - MYSQL_PASSWORD=mypassword
    expose:
      - 3306
      - 33060

  wordpress:
    image: wordpress:latest
    depends_on:
      - mydb
    volumes:
      - mywp_data:/var/www/html
    ports:
      - 8080:80
    restart: always
    environment:
      - WORDPRESS_DB_HOST=mydb
      - WORDPRESS_DB_USER=wp_user
      - WORDPRESS_DB_PASSWORD=mypassword
      - WORDPRESS_DB_NAME=wordpress

volumes:
  mydb_data:
  mywp_data:services:
  mydb:
    image: mariadb:10.6.4-focal
    command: '--default-authentication-plugin=mysql_native_password'
    volumes: 
    - mydb_data:/var/lib/mysql
    resart: always
    environment:
      - MYSQL_ROOT_PASSWORD=anypassword
      - MYSQL_DATABASE=wordpress
      - MYSQL_USER=wp_user
      - MYSQL_PASSWORD=mysql_native_password
    expose:
      - 3306
      - 33060
  wordpress:
  image: wordpress:latest
  volumes:
  - mywp_data:lvar/www/html
  ports: 
  - 8080:80
  resart: always
  environment:
  - WORDPRESS_DB_HOST=mydb
  - WORDPRESS_DB_USER=wp_user
  - WORDPRESS_DB_PASSWORD=mypassword
  - WORDPRESS_DB_NAME=wordpress
volumes:
  mydb_data:
  mywp_data:
